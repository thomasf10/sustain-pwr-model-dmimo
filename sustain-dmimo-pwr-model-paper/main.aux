\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Network energy efficiency \eqref  {eq:ee_net} over the sweep of \Cref  {fig:eval2}, at $P_{\mathrm  {TX}}=\SI {12.8}{\watt }$, $LM=128$ antennas and $K=20$ \glspl {ue}. Both axes are logarithmic, which makes the ceiling $1/(\Pi _{\mathrm  {FH}}L)$ of \Cref  {rem:fh_ceiling} the straight dashed line. That ceiling bounds the data-sharing splits S2 and S3, whose fronthaul carries the payload duplicated to every \gls {ap}. It does not bound S1, which forwards samples and duplicates nothing, so S1 lying above it at large $L$ is not a violation. The co-located baseline is the marker at $L=1$, and it is the most efficient deployment anywhere in the figure.}}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:eval4}{{4}{9}{Network energy efficiency \eqref {eq:ee_net} over the sweep of \Cref {fig:eval2}, at $P_{\mathrm {TX}}=\SI {12.8}{\watt }$, $LM=128$ antennas and $K=20$ \glspl {ue}. Both axes are logarithmic, which makes the ceiling $1/(\Pi _{\mathrm {FH}}L)$ of \Cref {rem:fh_ceiling} the straight dashed line. That ceiling bounds the data-sharing splits S2 and S3, whose fronthaul carries the payload duplicated to every \gls {ap}. It does not bound S1, which forwards samples and duplicates nothing, so S1 lying above it at large $L$ is not a violation. The co-located baseline is the marker at $L=1$, and it is the most efficient deployment anywhere in the figure}{figure.caption.9}{}}
